---
/**
 * "About the data" (spec §6.4), generated from meta.json and ATTRIBUTION.md at build time: key
 * facts, the attribution (with the licence's required notice verbatim — the build fails if it
 * isn't), the processing steps and the limitations, all as recorded in the data files.
 */
import { attributionBlocks, dataFacts } from '../../lib/viz/explorer/about';
import { basinFacts, inegiNote } from '../../lib/viz/explorer/about';
import { placeName, type PlaceLabelsFile } from '../../lib/viz/explorer/labels';
import type { BasinMaskFile, ColoradoMeta } from '../../lib/viz/explorer/types';

interface Props {
  meta: ColoradoMeta;
  attribution: string;
  /** basin-mask.json (stretch S3), or null. */
  basin: BasinMaskFile | null;
  places: PlaceLabelsFile | null;
  id: string;
}
const { meta, attribution, basin, places, id } = Astro.props;
const facts = dataFacts(meta);
const blocks = attributionBlocks(attribution, meta);
const bFacts = basin ? basinFacts(basin, meta) : [];
const inegi = basin ? inegiNote(basin) : null;
---

<section class="section about-data" id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>About the data</h2>
  <p class="about-data__lede">
    Generated from{' '}
    {['meta.json', 'ATTRIBUTION.md', meta.basinMask?.metaFile, places && 'labels.json']
      .filter(Boolean)
      .map((file, i) => (
        <>
          {i > 0 && ', '}
          <code>{file}</code>
        </>
      ))}{' '}
    in <code>/data/colorado/</code>.
  </p>

  <dl class="about-data__facts">
    {facts.map((f) => (
      <div>
        <dt>{f.label}</dt>
        <dd>{f.href ? <a href={f.href}>{f.value}</a> : f.value}</dd>
      </div>
    ))}
  </dl>

  <h3>Attribution</h3>
  <div class="about-data__attribution" data-attribution>
    {blocks.map((b) => {
      const inner = b.segments.map((s) => (s.href ? <a href={s.href}>{s.text}</a> : s.text));
      if (b.kind === 'quote') return <blockquote data-required-notice>{inner}</blockquote>;
      if (b.kind === 'heading') return <p class="about-data__subhead">{inner}</p>;
      return <p>{inner}</p>;
    })}
  </div>

  <h3>Processing steps</h3>
  <ol class="about-data__list" data-processing>
    {meta.processing.map((step) => (
      <li>{step}</li>
    ))}
  </ol>

  <h3>Limitations</h3>
  <ul class="about-data__list" data-limitations>
    {meta.limitations.map((l) => (
      <li>{l}</li>
    ))}
  </ul>

  {basin && (
    <div data-basin-about>
      <h3>Basin mask</h3>
      <p class="about-data__text">{basin.description}</p>
      <p class="about-data__text" data-basin-credit>
        {basin.attribution.credit}
      </p>
      <dl class="about-data__facts">
        {bFacts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.href ? <a href={f.href}>{f.value}</a> : f.value}</dd>
          </div>
        ))}
      </dl>
      <p class="about-data__text">{basin.attribution.originatorsNote}</p>
      {inegi && <p class="about-data__text">{inegi}</p>}
      <p class="about-data__subhead">Coverage notes</p>
      <ul class="about-data__list" data-basin-coverage>
        {basin.coverage.map((c) => (
          <li>{c}</li>
        ))}
      </ul>
    </div>
  )}
  {places && (
    <div id="place-labels-source">
      <h3>Place labels</h3>
      <p class="about-data__text" data-place-credit>
        {places.attribution.credit}
      </p>
      <p class="about-data__text">
        Labels marked “mouth” use the downstream point recorded by GNIS.{' '}
        <a href={places.source.page}>GNIS Domestic Names data</a> ·{' '}
        <a href="https://www.usgs.gov/us-board-on-geographic-names/what-geographic-names-information-system-gnis">
          USGS FAQ on GNIS coordinates
        </a>
      </p>
      <details>
        <summary>All {places.count} places and coordinates</summary>
        <ul class="about-data__list" data-place-list>
          {places.labels.map((place) => (
            <li>
              {placeName(place)}
              {place.anchor === 'mouth' && ' (mouth)'}
              {' · '}
              {place.lat}, {place.lon}
            </li>
          ))}
        </ul>
      </details>
    </div>
  )}
</section>

<style>
  .about-data h3 {
    margin-top: var(--space-6);
  }

  .about-data__facts {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    max-width: var(--measure);
    font-size: var(--fs-small);
  }

  .about-data__facts div {
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    gap: var(--space-3);
  }

  @media (max-width: 36rem) {
    .about-data__facts div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }

  .about-data__facts dt {
    color: var(--color-text-muted);
  }

  .about-data__facts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .about-data__attribution p,
  .about-data__attribution blockquote {
    max-width: var(--measure);
  }

  .about-data__attribution a {
    overflow-wrap: anywhere;
  }

  blockquote {
    margin: 0 0 var(--space-4);
    padding: var(--space-2) var(--space-4);
    border-left: 3px solid var(--color-accent);
    background: var(--color-surface);
  }

  .about-data__text {
    max-width: var(--measure);
  }

  .about-data__facts + .about-data__text {
    margin-top: var(--space-4);
  }

  .about-data__list {
    max-width: var(--measure);
  }

  .about-data__list li + li {
    margin-top: var(--space-2);
  }
</style>
