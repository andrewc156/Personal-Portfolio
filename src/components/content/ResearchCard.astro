---
/** Research-area card (spec §4.3): thumbnail, linked heading, one-liner, "Related work →". */
import MathText from './MathText.astro';
import ResearchThumb from './ResearchThumb.astro';
import { plainText } from './format';
import { gardenTagHref, researchHref, type ResearchEntry } from './work';

interface Props {
  area: ResearchEntry;
  headingLevel?: 2 | 3;
}
const { area, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="research-card" data-research-card={area.id}>
  <div class="research-card__thumb">
    <ResearchThumb slug={area.id} />
  </div>
  <Heading class="research-card__title">
    <a href={researchHref(area.id)}>{area.data.title}</a>
  </Heading>
  <p class="research-card__summary">
    <MathText text={area.data.summary} />
  </p>
  <p class="research-card__more">
    <a href={gardenTagHref(area.id)} aria-label={`Related work: ${plainText(area.data.title)}`}>
      Related work <span aria-hidden="true">→</span>
    </a>
  </p>
</article>

<style>
  .research-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
  }

  .research-card__thumb {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-bottom: var(--space-2);
  }

  .research-card__title {
    font-size: clamp(var(--fs-h3), 1.04rem + 0.45vw, 1.4375rem);
    margin: 0;
    text-wrap: pretty;
  }

  .research-card__title a {
    color: var(--color-text);
    text-decoration-color: var(--color-control);
  }

  @media (hover: hover) and (pointer: fine) {
    .research-card__title a:hover {
      color: var(--color-accent);
      text-decoration-color: currentColor;
    }
  }

  .research-card__summary,
  .research-card__more {
    margin: 0;
  }

  .research-card__more {
    margin-block-start: auto;
    padding-block-start: var(--space-1);
    font-size: var(--fs-small);
  }
</style>
