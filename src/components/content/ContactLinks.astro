---
/** List of contact links. Callers render nothing when the list is empty. */
import type { ContactLink } from './contact';

interface Props {
  links: ContactLink[];
}
const { links } = Astro.props;
---

<dl class="contact-links">
  {links.map((l) => (
    <div class="contact-links__row">
      <dt>{l.label}</dt>
      <dd>
        <a href={l.href}>{l.text}</a>
      </dd>
    </div>
  ))}
</dl>

<style>
  .contact-links {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    margin: 0;
  }

  /*
   * Every row has the same layout at a given width: below 30rem each label sits on its own
   * line above its value; from 30rem up, labels share a fixed 6rem column.
   */
  .contact-links__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 var(--space-3);
    min-width: 0;
  }

  @media (min-width: 30rem) {
    .contact-links__row {
      grid-template-columns: 6rem minmax(0, 1fr);
    }
  }

  .contact-links dt {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .contact-links dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
</style>
