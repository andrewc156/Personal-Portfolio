---
/**
 * One work item in citation style (spec §4.3): authors with Andrew in bold, date as
 * "Mon YYYY" (or a range for projects), title, venue in italics, then small buttons only
 * for links that exist. A submitted item shows "Submitted" in place of date and venue.
 * Empty fields render nothing.
 */
import './content.css';
import DateRange from './DateRange.astro';
import DraftBadge from './DraftBadge.astro';
import MathText from './MathText.astro';
import { LINK_BUTTONS, STATUS_LABELS, TYPE_LABELS } from './constants';
import { formatMonth, isAndrewName, plainText } from './format';
import type { WorkEntry } from './work';
import { withBase } from '../../lib/url';
import { displayName, profile } from '../site/profile';

interface Props {
  item: WorkEntry;
  /** Show the type tag before the citation (used where types are mixed). */
  showType?: boolean;
}

const { item, showType = false } = Astro.props;
const d = item.data;
const andrew = [displayName, profile.full_name].filter(Boolean);
const status = d.status ? STATUS_LABELS[d.status] : '';
const when = status ? '' : formatMonth(d.date);
const buttons = LINK_BUTTONS.flatMap(([key, label]) => {
  const href = d.links[key];
  return href ? [{ href: withBase(href), label }] : [];
});
const titleText = d.title || (d.draft ? 'Title needed' : '');
---

<article class="citation" data-citation data-id={item.id}>
  <p class="citation__text">
    {showType && <span class="type-tag">{TYPE_LABELS[d.type]}</span>}
    <span class="citation__authors">
      {d.authors.map((a, i) => (
        <>
          {i > 0 &&
            (i === d.authors.length - 1 ? (d.authors.length > 2 ? ', and ' : ' and ') : ', ')}
          {isAndrewName(a, andrew) ? <strong>{a}</strong> : <span>{a}</span>}
        </>
      ))}
    </span>
    {when && (
      <>
        {' '}
        (<DateRange date={d.date} end={d.end} ongoing={d.ongoing} />
        ).
      </>
    )}
    {!when && '.'}
    {titleText && (
      <>
        {' '}
        {d.links.site ? (
          <a class="citation__title" href={withBase(d.links.site)}>
            <MathText text={titleText} />
          </a>
        ) : (
          <span class="citation__title">
            <MathText text={titleText} />
          </span>
        )}
        .
      </>
    )}
    {status && (
      <>
        {' '}
        <span class="citation__status" data-status={d.status}>
          {status}
        </span>
        .
      </>
    )}
    {!status && d.venue && (
      <>
        {' '}
        <em class="citation__venue">{d.venue}</em>.
      </>
    )}
    {d.draft && <DraftBadge />}
  </p>
  {buttons.length > 0 && (
    <ul
      class="citation__links"
      aria-label={`Links for ${plainText(titleText) || TYPE_LABELS[d.type]}`}
    >
      {buttons.map((b) => (
        <li>
          <a class="link-btn" href={b.href}>
            {b.label}
          </a>
        </li>
      ))}
    </ul>
  )}
</article>

<style>
  .citation__text {
    margin: 0;
  }

  .citation__authors strong {
    font-weight: var(--fw-semibold);
  }
</style>
