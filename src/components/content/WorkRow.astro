---
/**
 * One Garden row (spec §4.1): type tag (mono, small caps) → title → one-line
 * description (plus venue) → date as "Mon YYYY". The whole row is one link when
 * the item has somewhere to go. Empty fields render nothing.
 */
import './content.css';
import DraftBadge from './DraftBadge.astro';
import { TYPE_LABELS } from './constants';
import { formatMonth, isoDate } from './format';
import { primaryHref, type WorkEntry } from './work';

interface Props {
  item: WorkEntry;
}
const { item } = Astro.props;
const d = item.data;
const href = primaryHref(item);
const when = formatMonth(d.date);
const title = d.title || (d.draft ? 'Title needed' : '');
const Tag = href ? 'a' : 'div';
---

<li
  class="work-row"
  data-work-row
  data-id={item.id}
  data-type={d.type}
  data-tags={d.tags.join(' ')}
>
  <Tag class="work-row__inner" href={href}>
    <span class="type-tag work-row__type">{TYPE_LABELS[d.type]}</span>
    <span class="work-row__body">
      <span class="work-row__title">
        {title}
        {d.draft && <DraftBadge />}
      </span>
      {(d.description || d.venue) && (
        <span class="work-row__desc">
          {d.description}
          {d.description && d.venue && <span aria-hidden="true"> · </span>}
          {d.venue && <span class="work-row__venue">{d.venue}</span>}
        </span>
      )}
    </span>
    {when && (
      <time class="work-row__date" datetime={isoDate(d.date)}>
        {when}
      </time>
    )}
  </Tag>
</li>

<style>
  .work-row {
    border-top: 1px solid var(--color-border);
  }

  .work-row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .work-row__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'type date'
      'body body';
    gap: var(--space-1) var(--space-4);
    padding: var(--space-4) var(--space-2);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  @media (min-width: 48rem) {
    .work-row__inner {
      grid-template-columns: 7rem minmax(0, 1fr) auto;
      grid-template-areas: 'type body date';
      align-items: baseline;
    }
  }

  a.work-row__inner:hover {
    background: var(--color-surface-sunken);
    color: var(--color-text);
  }

  a.work-row__inner:hover .work-row__title {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .work-row__type {
    grid-area: type;
    margin: 0;
  }

  .work-row__body {
    grid-area: body;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: var(--measure);
  }

  .work-row__title {
    font-weight: var(--fw-semibold);
  }

  .work-row__desc {
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }

  .work-row__date {
    grid-area: date;
    font-family: var(--font-mono);
    font-size: var(--fs-xsmall);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
</style>
