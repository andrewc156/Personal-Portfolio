---
/** Decorative SVG illustration, made at build time (no runtime JS). */
import { THUMB_VIEWBOX, thumbnailMarkup } from './thumb';

interface Props {
  slug: string;
  class?: string;
}
const { slug, class: className } = Astro.props;
---

<svg
  class:list={['research-thumb', className]}
  viewBox={THUMB_VIEWBOX}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  data-thumb={slug}
>
  <g set:html={thumbnailMarkup(slug)} />
  <rect x="8" y="98" width="86" height="18" rx="2" fill="var(--color-surface-sunken)" />
  <text x="12" y="111">
    Illustration
  </text>
</svg>

<style>
  .research-thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
  }

  text {
    fill: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-caps);
  }
</style>
