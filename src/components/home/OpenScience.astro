---
/**
 * Home: Open science (spec §4.3 item 5). Describes only what is true. Repository
 * links render only when a URL is set in src/data/open-science.yaml (or profile
 * site.source_url for the site's own source).
 */
import { getCopy, getRepos } from '../content/work';
import { profile } from '../site/profile';

interface Props {
  id: string;
}
const { id } = Astro.props;
const copy = await getCopy('open_science');
const src = profile.site.source_url;
const listed = await getRepos();
// The site's own source comes first, whether it is listed in open-science.yaml or not.
const own =
  listed.find((r) => r.url === src) ??
  (src ? { label: 'Source for this site', url: src } : undefined);
const repos = [...(own ? [own] : []), ...listed.filter((r) => r !== own)];
---

<section id={id} class="section home-section home-section--split" aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`} class="section-title">
      Open science
    </h2>
    <div class="home-section__body">
      {copy.text && <p data-confirmed={String(copy.confirmed)}>{copy.text}</p>}
      {repos.length > 0 && (
        <ul class="repos" role="list" data-repos>
          {repos.map((r) => (
            <li>
              <a href={r.url}>
                {r.label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  p {
    margin-block-end: var(--space-3);
  }

  .repos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
