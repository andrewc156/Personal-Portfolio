---
/**
 * Home: Teaching & outreach (spec §4.3 item 6). Rendered only when
 * src/data/teaching.yaml has entries; it is empty for now, so this renders nothing.
 */
import { parse } from 'yaml';
import raw from '../../data/teaching.yaml?raw';

export interface Props {
  id: string;
}

interface Entry {
  title: string;
  detail?: string;
}

const { id } = Astro.props;
const parsed: unknown = parse(raw);
const entries: Entry[] = Array.isArray(parsed)
  ? parsed.filter((e): e is Entry => typeof e?.title === 'string' && e.title.trim() !== '')
  : [];
---

{entries.length > 0 && (
  <section id={id} class="section home-section home-section--split" aria-labelledby={`${id}-title`}>
    <div class="container">
      <h2 id={`${id}-title`} class="section-title">
        Teaching &amp; outreach
      </h2>
      <ul class="home-section__body">
        {entries.map((e) => (
          <li>
            {e.title}
            {e.detail && <span>. {e.detail}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  ul {
    margin-block-end: 0;
    padding-inline-start: var(--space-5);
  }
</style>
