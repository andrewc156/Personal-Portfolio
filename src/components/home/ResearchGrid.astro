---
/** Home: Research (spec §4.3 item 4). One card per research area. */
import ResearchCard from '../content/ResearchCard.astro';
import { getResearch } from '../content/work';

interface Props {
  id: string;
}
const { id } = Astro.props;
const areas = await getResearch();
---

<section id={id} class="section home-section" aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`} class="section-title">
      Research
    </h2>
    <ul class="research-grid">
      {areas.map((area) => (
        <li>
          <ResearchCard area={area} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .research-grid {
    display: grid;
    gap: var(--space-6) clamp(var(--space-4), 2.5vw, var(--space-6));
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }

  .research-grid > li {
    display: flex;
    min-width: 0;
  }

  @media (min-width: 42rem) {
    .research-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
