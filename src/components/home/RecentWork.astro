---
/** Home: Recent work (spec §4.3 item 3). Latest five items in citation style. */
import Citation from '../content/Citation.astro';
import { getWork } from '../content/work';
import '../content/content.css';
import { withBase } from '../../lib/url';

interface Props {
  id: string;
}
const { id } = Astro.props;
const items = (await getWork()).slice(0, 5);
---

<section id={id} class="section home-section home-section--split" aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`} class="section-title">
      Recent work
    </h2>
    <div class="home-section__body">
      {items.length > 0 && (
        <ul class="citation-list" data-recent-work>
          {items.map((item) => (
            <li>
              <Citation item={item} showType />
            </li>
          ))}
        </ul>
      )}
      <p class="work-more">
        <a href={withBase('/garden/')}>
          All work <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .citation-list {
    gap: 0;
    margin-block-end: var(--space-3);
  }

  .citation-list > li {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .citation-list > li:first-child {
    padding-block-start: 0;
  }

  .work-more {
    margin: 0;
    font-weight: var(--fw-semibold);
  }
</style>
