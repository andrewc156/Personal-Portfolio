---
/** Home: Mission (spec §4.3 item 2). Draft copy from src/data/copy.yaml. */
import { getCopy } from '../content/work';

interface Props {
  id: string;
}
const { id } = Astro.props;
const mission = await getCopy('mission');
---

<section
  id={id}
  class="section home-section home-section--split home-mission"
  aria-labelledby={`${id}-title`}
>
  <div class="container">
    <h2 id={`${id}-title`} class="section-title">
      Mission
    </h2>
    {mission.text && (
      <p class="mission home-section__body" data-confirmed={String(mission.confirmed)}>
        {mission.text}
      </p>
    )}
  </div>
</section>

<style>
  .mission {
    max-width: 53ch;
    margin: 0;
    font-size: clamp(1.25rem, 1.02rem + 0.8vw, 1.625rem);
    line-height: 1.48;
    text-wrap: pretty;
  }
</style>
