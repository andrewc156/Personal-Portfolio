---
/** Home: Contact (spec §4.3 item 7). Only links that exist; hidden when there are none. */
import ContactLinks from '../content/ContactLinks.astro';
import { contactLinks } from '../content/contact';

export interface Props {
  id: string;
}
const { id } = Astro.props;
const links = contactLinks();
---

{links.length > 0 && (
  <section id={id} class="section" aria-labelledby={`${id}-title`}>
    <div class="container">
      <h2 id={`${id}-title`} class="section-title">
        Contact
      </h2>
      <ContactLinks links={links} />
    </div>
  </section>
)}
