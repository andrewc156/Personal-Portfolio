---
/**
 * Home hero (spec §4.3 item 1, §6.3): name, hero question, keywords, and the synthetic Rising
 * water canvas with its barcode strip. The static terrain illustration sits under the canvas
 * as a no-JS fallback; every box has a fixed size before hydration so nothing shifts.
 * Behaviour: hero-client.ts → src/lib/viz/hero/controller.ts (Rising water) or, lazily,
 * src/lib/viz/hero/modes/ (Dye spill, Fractal pond, Random rivers, Collatz delta).
 * Settings: HeroSettings.astro.
 */
import TerrainArt from '../site/TerrainArt.astro';
import { displayName, profile } from '../site/profile';
import { withBase } from '../../lib/url';
import { DEFAULT_MODE, HERO_MODES, modeMeta } from '../../lib/viz/hero/modes/meta';

// Rising water is the default mode; hero-client.ts swaps these texts when another mode runs.
const rising = modeMeta(DEFAULT_MODE);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__text">
      <h1 id="hero-title">{displayName}</h1>
      {profile.hero_question.text && <p class="hero__question">{profile.hero_question.text}</p>}
      {profile.keywords.length > 0 && (
        <ul class="hero__keywords" aria-label="Keywords">
          {profile.keywords.map((k) => (
            <li>{k}</li>
          ))}
        </ul>
      )}
    </div>
    <figure class="hero__figure">
      <div class="hero__toolbar">
        <label for="hero-mode">Animation</label>
        <select id="hero-mode" name="hero-mode" form="hero-settings" disabled>
          {HERO_MODES.map(({ id, label }) => (
            <option value={id} selected={id === DEFAULT_MODE}>
              {label}
            </option>
          ))}
        </select>
        <button
          type="button"
          class="btn"
          aria-label="Animation settings"
          aria-controls="settings-panel"
          aria-expanded="false"
          disabled
        >
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M10.3 2.8h3.4l.5 2.4 1.7.8 2.1-1.4 2.4 2.4-1.4 2.1.8 1.7 2.4.5v3.4l-2.4.5-.8 1.7 1.4 2.1-2.4 2.4-2.1-1.4-1.7.8-.5 2.4h-3.4l-.5-2.4-1.7-.8-2.1 1.4-2.4-2.4 1.4-2.1-.8-1.7-2.4-.5v-3.4l2.4-.5.8-1.7-1.4-2.1 2.4-2.4 2.1 1.4 1.7-.8Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
            />
            <circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
          Settings
        </button>
      </div>
      <div
        class="hero__art"
        data-hero
        data-state="paused"
        data-running="false"
        data-mode="rising"
        role="group"
        aria-label={rising.groupLabel}
        aria-describedby="hero-keys"
        aria-keyshortcuts={rising.shortcuts}
      >
        <div class="hero__map">
          <TerrainArt class="hero__fallback" />
          <canvas
            class="hero__canvas"
            data-hero-map
            role="img"
            aria-label="Map of a random landscape. Water rises over it; lakes appear in valleys and merge as the water spills over passes."
          ></canvas>
        </div>
        <div class="hero__strip" data-hero-strip-box>
          <canvas
            class="hero__strip-canvas"
            data-hero-strip
            role="img"
            aria-label="Barcode: one bar per lake, from the water level where it is born to the level where it spills into an older lake. The lowest lake's bar never ends."
          ></canvas>
        </div>
        <div class="hero__bar">
          {/* Disabled until hero-client.ts runs (it also makes the box a tab stop and clears
              the no-JS note in the readout), so a no-JS visit has no dead focus stops (QA-16). */}
          <button type="button" class="btn hero__btn" data-hero-play disabled>
            Play
          </button>
          <button type="button" class="btn hero__btn" data-hero-new disabled>
            New terrain
          </button>
          <p class="hero__readout" data-hero-readout>
            A still picture. The animation needs JavaScript.
          </p>
        </div>
        <p id="hero-keys" class="visually-hidden" data-hero-keys>
          {rising.keys}
        </p>
        <p class="visually-hidden" aria-live="polite" data-hero-summary></p>
      </div>
      <figcaption class="hero__caption">
        <span data-hero-caption>{rising.caption}</span>
        <span data-hero-caption-link>
          {' '}
          <a href={withBase('/rising-water/')}>See it on the Colorado River Basin →</a>
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  import '../hero/hero-client';
</script>

<style>
  .hero {
    padding-block: var(--space-5) var(--space-6);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  @media (min-width: 52rem) {
    .hero {
      padding-block: var(--space-7) var(--space-6);
    }

    .hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-6);
    }

    /* Centre the name on the map and barcode, not on the toolbar-to-caption block. */
    .hero__text {
      padding-bottom: var(--space-4);
    }
  }

  .hero__question {
    font-size: 1.25rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    max-width: 34ch;
  }

  .hero__keywords {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: var(--space-5) 0 0;
    list-style: none;
  }

  .hero__keywords li {
    font-family: var(--font-mono);
    font-size: var(--fs-xsmall);
    padding: 0.125rem var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
  }

  .hero__figure {
    margin: 0;
    min-width: 0;
  }

  .hero__toolbar {
    display: grid;
    grid-template-columns: max-content minmax(0, 12rem) max-content;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  /* Very narrow screens (below ≈350 px): the label takes its own line so the closed select is wide
     enough for the longest mode name (QA-13). Pure CSS, fixed from first paint: no shift. */
  @media (max-width: 22rem) {
    .hero__toolbar {
      grid-template-columns: minmax(0, 1fr) max-content;
      row-gap: var(--space-1);
    }

    .hero__toolbar label {
      grid-column: 1 / -1;
    }
  }

  .hero__toolbar select {
    min-width: 0;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-control);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .hero__toolbar :is(select, button) {
    min-height: 2.75rem;
  }

  .hero__toolbar select:enabled {
    cursor: pointer;
  }

  .hero__art {
    container: hero-art / inline-size;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
  }

  .hero__art:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .hero__map {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-surface-sunken);
  }

  .hero__map :global(.hero__fallback) {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .hero__canvas,
  .hero__strip-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    cursor: crosshair;
    touch-action: manipulation;
  }

  .hero__art[data-mode='rivers'] .hero__canvas,
  .hero__art[data-mode='collatz'] .hero__canvas {
    cursor: default;
  }

  .hero__strip {
    height: 6.5rem;
    border-top: 1px solid var(--color-border);
  }

  .hero__strip[hidden] {
    display: none;
  }

  .hero__strip-canvas {
    touch-action: manipulation;
  }

  .hero__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    min-height: 3rem;
    padding: var(--space-2) var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .hero__btn {
    flex: none;
    min-width: 4.5rem;
  }

  /* Own full-width line under the buttons, wrapping, with room for two lines reserved
     (three on very narrow screens) so changing text never shifts the layout. */
  .hero__readout {
    flex: 1 0 100%;
    min-width: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xsmall);
    line-height: 1.4;
    min-height: 2.8em;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  @media (max-width: 26rem) {
    .hero__readout {
      min-height: 4.2em;
    }
  }

  /* Wide enough for the longest readout in two lines beside the buttons: one status row. */
  @container hero-art (min-width: 35rem) {
    .hero__readout {
      flex: 1 1 0;
      display: flex;
      align-items: center;
      margin-left: var(--space-2);
    }
  }

  .hero__caption {
    margin-top: var(--space-3);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    max-width: var(--measure);
  }

  .hero__caption a {
    white-space: nowrap;
  }

  .hero__caption [hidden] {
    display: none;
  }
</style>
