---
/**
 * Hero (spec §4.3 item 1). F1 stub: name, hero question, keywords and a static
 * terrain frame where F5's Rising water canvas will go. F5 replaces this file.
 */
import TerrainArt from '../site/TerrainArt.astro';
import { displayName, profile } from '../site/profile';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__text">
      <h1 id="hero-title">{displayName}</h1>
      {profile.hero_question.text && <p class="hero__question">{profile.hero_question.text}</p>}
      {profile.keywords.length > 0 && (
        <ul class="hero__keywords" aria-label="Keywords">
          {profile.keywords.map((k) => (
            <li>{k}</li>
          ))}
        </ul>
      )}
    </div>
    <div class="hero__frame">
      <TerrainArt />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-7) var(--space-6);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 52rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .hero__question {
    font-size: 1.25rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    max-width: 34ch;
  }

  .hero__keywords {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: var(--space-5) 0 0;
    list-style: none;
  }

  .hero__keywords li {
    font-family: var(--font-mono);
    font-size: var(--fs-xsmall);
    padding: 0.125rem var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
  }

  .hero__frame {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    aspect-ratio: 2 / 1;
  }

  .hero__frame :global(svg) {
    height: 100%;
  }
</style>
