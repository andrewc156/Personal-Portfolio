---
/** Labelled select menu for the settings panel. */
interface Option {
  value: string;
  label: string;
}

interface Props {
  id: string;
  label: string;
  options: readonly Option[];
  value?: string;
  name?: string;
  disabled?: boolean;
}

const { id, label, options, value, name, disabled = false } = Astro.props;
---

<div class="select-row">
  <label for={id}>{label}</label>
  <select class="select-field" id={id} name={name ?? id} disabled={disabled}>
    {options.map((o) => (
      <option value={o.value} selected={o.value === value}>
        {o.label}
      </option>
    ))}
  </select>
</div>

<style>
  .select-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-small);
  }

  .select-field {
    min-width: 9rem;
  }
</style>
