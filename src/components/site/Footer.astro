---
import { displayName, profile } from './profile';
import { withBase } from '../../lib/url';

const year = new Date().getFullYear();
const { source_url: sourceUrl, show_claude_code_credit: showCredit } = profile.site;
---

<footer class="site-footer">
  <div class="container">
    {/* Each group is unbreakable and carries the separator after it, so the line
        only wraps between groups and a wrapped line never starts with "·". */}
    <p>
      <span class="grp">
        © {year} {displayName}
        <span aria-hidden="true"> ·</span>
      </span>{' '}
      <span class="grp">
        <a href={withBase('/about/')}>About</a>
        {(sourceUrl || showCredit) && <span aria-hidden="true"> ·</span>}
      </span>
      {sourceUrl && (
        <>
          {' '}
          <span class="grp">
            <a href={sourceUrl}>Source</a>
            {showCredit && <span aria-hidden="true"> ·</span>}
          </span>
        </>
      )}
      {showCredit && (
        <>
          {' '}
          <span class="grp">Built with help from Claude Code</span>
        </>
      )}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }

  .site-footer p {
    margin: 0;
    max-width: none;
  }

  .grp {
    white-space: nowrap;
  }
</style>
