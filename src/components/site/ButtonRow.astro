---
/**
 * A row of action buttons for the settings panel. Put `<button class="btn">`
 * elements in the slot; use aria-pressed for toggles such as Play/Pause.
 */
interface Props {
  /** Accessible name for the group, if the buttons need one. */
  label?: string;
}
const { label } = Astro.props;
---

<div class="button-row" role={label ? 'group' : undefined} aria-label={label}>
  <slot />
</div>

<style>
  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
