---
/**
 * Art settings panel shell (spec §4.1). Right-hand drawer on desktop, bottom
 * sheet on mobile. The desktop drawer is non-modal so the art stays visible while it
 * changes; the narrow sheet is a modal dialog (settings.ts, QA-03).
 * Behaviour lives in settings.ts (Esc closes, focus returns to the opener,
 * open/closed state remembered in localStorage).
 * The root is a div with role="complementary", not <aside>: settings.ts switches the role
 * to "dialog" on narrow screens, which ARIA in HTML doesn't allow on <aside>.
 */
interface Props {
  title?: string;
}
const { title = 'Art settings' } = Astro.props;
---

<div
  id="settings-panel"
  class="settings"
  role="complementary"
  aria-labelledby="settings-title"
  hidden
>
  <div class="settings__head">
    <h2 id="settings-title" class="settings__title" tabindex="-1" data-settings-title>
      {title}
    </h2>
    <button type="button" class="icon-btn" data-settings-close aria-label="Close art settings">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M6 6l12 12M18 6L6 18"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </div>
  <div class="settings__body">
    <slot />
  </div>
</div>

<style>
  .settings {
    position: fixed;
    z-index: 50;
    /* Starts below the header (pinned while open, see Header.astro) so the
       gear and theme toggle stay visible and clickable. */
    inset: var(--shell-header-h, var(--header-h)) 0 0 auto;
    width: min(var(--panel-w), 100vw);
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    color: var(--color-text);
    border-left: 1px solid var(--color-border);
    box-shadow: var(--shadow-panel);
    /* F28: enter/exit are transitions so they retarget when interrupted. These values
       apply while opening (the destination state's transition is the one used). Only
       transform moves; the surface stays opaque. Browsers without @starting-style or
       transition-behavior simply show and hide the panel instantly. */
    transform: none;
    transition:
      transform var(--dur-drawer-in) var(--ease-drawer),
      display var(--dur-drawer-in) allow-discrete;
  }

  @starting-style {
    .settings {
      /* The extra 2rem hides the panel shadow off-screen. */
      transform: translateX(calc(100% + 2rem));
    }
  }

  .settings[hidden] {
    display: none;
    transform: translateX(calc(100% + 2rem));
    /* A tap on the leaving panel does nothing. */
    pointer-events: none;
    /* Values used when closing: a little faster than the enter. */
    transition:
      transform var(--dur-drawer-out) var(--ease-drawer),
      display var(--dur-drawer-out) allow-discrete;
  }

  .settings__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .settings__title {
    margin: 0;
    font-size: var(--fs-small);
    font-family: var(--font-mono);
    font-weight: var(--fw-regular);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .settings__title:focus {
    outline: none;
  }

  .settings__title:focus-visible {
    outline: 2px solid var(--color-focus);
  }

  .settings__body {
    flex: 1 1 auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-4) var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* Mobile: bottom sheet */
  @media (max-width: 40rem) {
    .settings {
      inset: auto 0 0 0;
      width: 100%;
      max-height: 65vh;
      max-height: 65dvh;
      border-left: 0;
      border-top: 1px solid var(--color-border);
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      padding-bottom: env(safe-area-inset-bottom, 0);
    }

    @starting-style {
      .settings {
        transform: translateY(calc(100% + 2rem));
      }
    }

    .settings[hidden] {
      transform: translateY(calc(100% + 2rem));
    }
  }

  /* F28: dim the page behind the modal sheet (narrow screens only: settings.ts sets
     data-settings-modal for the sheet, never for the wide drawer). Opacity only. Pointer
     events pass through to <body>, so the backdrop-click handler in settings.ts keeps
     working unchanged. */
  :global(body)::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 49; /* just under the panel (50) */
    background: var(--color-scrim);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-drawer-out) var(--ease-out);
  }

  :global(:root[data-settings-modal]) :global(body)::after {
    opacity: 1;
    transition-duration: var(--dur-drawer-in);
  }

  /* Reduced motion: no movement at all. The panel appears and disappears in place
     (durations are already 0 through tokens.css and the global reset). */
  @media (prefers-reduced-motion: reduce) {
    .settings,
    .settings[hidden] {
      transform: none;
    }

    @starting-style {
      .settings {
        transform: none;
      }
    }
  }
</style>
