---
/* Theme toggle button. aria-pressed = dark theme active (set by theme.ts).
   Rendered disabled: theme.ts enables it, so without JavaScript it is no dead tab stop
   (the page then follows the OS theme). */
---

<button
  type="button"
  class="icon-btn theme-toggle"
  data-theme-toggle
  aria-pressed="false"
  aria-label="Dark theme"
  title="Toggle dark theme"
  disabled
>
  <svg
    class="theme-toggle__moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M12 2.5A8 8 0 0 0 21.5 12 9.5 9.5 0 1 1 12 2.5Z"></path>
  </svg>
  <svg
    class="theme-toggle__sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4.5"></circle>
    <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"></path>
  </svg>
</button>

<style>
  .theme-toggle__sun {
    display: none;
  }
  .theme-toggle[aria-pressed='true'] .theme-toggle__sun {
    display: block;
  }
  .theme-toggle[aria-pressed='true'] .theme-toggle__moon {
    display: none;
  }
</style>
