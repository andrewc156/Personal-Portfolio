---
/**
 * Site shell: head, theme bootstrap, skip link, header, main, footer and the
 * optional art settings panel. A page that fills the `settings` slot gets the
 * gear button in the header and the panel.
 */
import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import Seo from '../components/site/Seo.astro';
import SettingsPanel from '../components/site/SettingsPanel.astro';
import { displayName, profile } from '../components/site/profile';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
}

const { title, description = profile.tagline.text } = Astro.props;
const fullTitle = title ? `${title} · ${displayName}` : displayName;
const hasSettings = Astro.slots.has('settings');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch {
        /* storage blocked: follow the OS theme */
      }
    </script>
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <Seo title={fullTitle} description={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header hasSettings={hasSettings} />
    {/* Right after the header so keyboard order runs gear → panel → page. */}
    {hasSettings && (
      <SettingsPanel>
        <slot name="settings" />
      </SettingsPanel>
    )}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../components/site/shell-client';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    z-index: 100;
    top: var(--space-2);
    left: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: var(--radius-sm);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus,
  .skip-link:focus-visible {
    transform: none;
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }
</style>
