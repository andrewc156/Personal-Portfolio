---
/**
 * Garden: selected work (spec §4.1, §5). Filter chips by type and research area,
 * `?type=` / `?tag=` deep links, and every row visible when JavaScript is off.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkRow from '../../components/content/WorkRow.astro';
import { TYPE_PLURALS, WORK_TYPES, RESEARCH_SLUGS } from '../../components/content/constants';
import { getResearch, getWork } from '../../components/content/work';
import { displayName } from '../../components/site/profile';
import { withBase } from '../../lib/url';

const items = await getWork();
const areas = await getResearch();
const presentTypes = WORK_TYPES.filter((t) => items.some((i) => i.data.type === t));
// Known types with nothing listed: no visible chip, but a ?type= deep link to one shows
// its chip as the active filter with a clear action (QA-17, DECISIONS #88).
const unlistedTypes = WORK_TYPES.filter((t) => !presentTypes.includes(t));
const noun = items.length === 1 ? 'item' : 'items';

// Describe the sort order truthfully: undated items (e.g. submitted manuscripts) sort first.
const undated = items.filter((i) => !i.data.date);
const lede =
  undated.length === 0
    ? 'Newest first.'
    : undated.every((i) => i.data.status === 'submitted')
      ? 'Submitted work has no date yet, so it comes first. The rest is newest first.'
      : 'Undated work comes first. The rest is newest first.';

// Name only the types that are actually listed, so the description never promises
// work that is still a draft (drafts are excluded from production builds).
const typeWords = presentTypes.map((t) => TYPE_PLURALS[t].toLowerCase());
const typeList =
  typeWords.length <= 2
    ? typeWords.join(' and ')
    : `${typeWords.slice(0, -1).join(', ')} and ${typeWords[typeWords.length - 1]}`;
const description = typeList
  ? `Selected work by ${displayName}: ${typeList}, filterable by type and research area.`
  : `Selected work by ${displayName}, filterable by type and research area.`;
---

<BaseLayout title="Garden" description={description}>
  <div
    class="container garden"
    data-garden
    data-types={WORK_TYPES.join(' ')}
    data-tags={RESEARCH_SLUGS.join(' ')}
  >
    <header class="garden__head">
      <h1>Garden</h1>
      <p class="garden__lede">Here's some of my work. {lede}</p>
    </header>

    <nav class="garden-filters" aria-label="Filter work">
      <div class="filter-group" role="group" aria-labelledby="filter-type-label">
        <span id="filter-type-label" class="filter-group__label">
          Type
        </span>
        <ul class="chips">
          <li>
            <a
              class="chip"
              href={withBase('/garden/')}
              data-filter="type"
              data-value=""
              aria-current="true"
            >
              All types
            </a>
          </li>
          {presentTypes.map((t) => (
            <li>
              <a
                class="chip"
                href={withBase(`/garden/?type=${t}`)}
                data-filter="type"
                data-value={t}
              >
                {TYPE_PLURALS[t]}
              </a>
            </li>
          ))}
          {unlistedTypes.map((t) => (
            <li class="chips__unlisted" data-unlisted-type={t} data-label={TYPE_PLURALS[t]} hidden>
              <a
                class="chip"
                href={withBase(`/garden/?type=${t}`)}
                data-filter="type"
                data-value={t}
              >
                {TYPE_PLURALS[t]}
              </a>
              <a
                class="chip-clear"
                href={withBase('/garden/')}
                data-garden-clear="type"
                aria-label={`Clear the ${TYPE_PLURALS[t]} filter`}
              >
                Clear
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="filter-group" role="group" aria-labelledby="filter-tag-label">
        <span id="filter-tag-label" class="filter-group__label">
          Research area
        </span>
        <ul class="chips">
          <li>
            <a
              class="chip"
              href={withBase('/garden/')}
              data-filter="tag"
              data-value=""
              aria-current="true"
            >
              All areas
            </a>
          </li>
          {areas.map((a) => (
            <li>
              <a
                class="chip"
                href={withBase(`/garden/?tag=${a.id}`)}
                data-filter="tag"
                data-value={a.id}
              >
                {a.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <noscript>
      <p class="garden__note">Filtering needs JavaScript, so every item is shown below.</p>
    </noscript>

    <p class="garden__status" role="status" data-garden-status>
      {items.length} {noun}
    </p>

    <ol class="garden-list" aria-label="Work items" data-garden-list>
      {items.map((item) => (
        <WorkRow item={item} />
      ))}
    </ol>

    <p class="garden__empty" data-garden-empty hidden>
      <span data-garden-empty-text>Nothing matches these filters.</span>{' '}
      <a href={withBase('/garden/')} data-garden-reset>
        Show all work
      </a>
    </p>
  </div>
</BaseLayout>

<script>
  import '../../components/content/garden-client';
</script>

<style>
  .garden {
    padding-block: var(--space-7) var(--space-8);
  }

  .garden__lede {
    color: var(--color-text-muted);
  }

  .garden-filters {
    display: grid;
    gap: var(--space-3);
    margin-block: var(--space-5) var(--space-4);
  }

  /* Label above its chips on narrow screens; from 40rem up, a fixed label
     column so both groups line up and chips wrap within their own column. */
  .filter-group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }

  @media (min-width: 40.0625rem) {
    .filter-group {
      grid-template-columns: 8.5rem minmax(0, 1fr);
    }
  }

  .filter-group__label {
    font-family: var(--font-mono);
    font-size: var(--fs-xsmall);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-control);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--fs-small);
    text-decoration: none;
    touch-action: manipulation;
    -webkit-user-select: none;
    user-select: none;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-press) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .chip:hover {
      border-color: var(--color-accent);
      background: var(--color-accent-soft);
      color: var(--color-text);
    }
  }

  /* F28: press feedback. Scale only when motion is welcome. */
  @media (prefers-reduced-motion: no-preference) {
    .chip:active {
      transform: scale(0.97);
    }
  }

  .chips__unlisted:not([hidden]) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .chip-clear {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding-inline: var(--space-1);
    font-size: var(--fs-small);
  }

  .chip[aria-current='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .garden__status,
  .garden__note {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .garden-list {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }

  .garden__empty {
    padding-block: var(--space-5);
  }
</style>
