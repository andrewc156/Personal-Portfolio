---
/**
 * Research topic page (spec §5): description, position and advisor, methods and results
 * (only when known), related work. The water-quality page (RiverNets) links to the
 * Rising water explorer, which uses the RiverNets study area.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Citation from '../../components/content/Citation.astro';
import DateRange from '../../components/content/DateRange.astro';
import MathText from '../../components/content/MathText.astro';
import ResearchThumb from '../../components/content/ResearchThumb.astro';
import { plainText } from '../../components/content/format';
import {
  gardenTagHref,
  getResearch,
  getWork,
  type ResearchEntry,
} from '../../components/content/work';
import '../../components/content/content.css';
import { withBase } from '../../lib/url';

export const getStaticPaths = (async () => {
  const areas = await getResearch();
  return areas.map((area) => ({ params: { slug: area.id }, props: { area } }));
}) satisfies GetStaticPaths;

interface Props {
  area: ResearchEntry;
}

const { area } = Astro.props;
const d = area.data;
const related = (await getWork()).filter((w) => (w.data.tags as string[]).includes(area.id));
const p = d.position;
const linksRisingWater = area.id === 'water-quality';
---

<BaseLayout title={d.title} description={plainText(d.summary)}>
  <article class="container topic" data-topic={area.id}>
    <p class="eyebrow">
      <a href={withBase('/research/')}>Research</a>
    </p>
    <h1>{d.title}</h1>
    <div class="topic__thumb">
      <ResearchThumb slug={area.id} />
    </div>

    <section class="topic__section" aria-labelledby="topic-about">
      <h2 id="topic-about">About</h2>
      <p>
        <MathText text={d.summary} />
      </p>
      {d.description && (
        <p>
          <MathText text={d.description} />
        </p>
      )}
      {(p || d.advisor) && (
        <dl class="topic__facts" data-position>
          {p && (
            <div>
              <dt>Position</dt>
              <dd>
                {p.role}, {p.organization}
                {' · '}
                <DateRange date={p.start} end={p.end} ongoing={p.ongoing} />
              </dd>
            </div>
          )}
          {d.advisor && (
            <div>
              <dt>Advisor</dt>
              <dd data-advisor>{d.advisor}</dd>
            </div>
          )}
        </dl>
      )}
      {linksRisingWater && (
        <p data-rising-water-link>
          The <a href={withBase('/rising-water/')}>Rising water explorer</a> on this site is built
          from elevation data for the Colorado River Basin study area (RiverNets coverage).
        </p>
      )}
    </section>

    {d.methods.length > 0 && (
      <section class="topic__section" aria-labelledby="topic-methods">
        <h2 id="topic-methods">Methods</h2>
        <ul>
          {d.methods.map((m) => (
            <li>
              <MathText text={m} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {d.results.length > 0 && (
      <section class="topic__section" aria-labelledby="topic-results">
        <h2 id="topic-results">Results</h2>
        <ul>
          {d.results.map((r) => (
            <li>
              <MathText text={r} />
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="topic__section" aria-labelledby="topic-work">
      <h2 id="topic-work">Related work</h2>
      {related.length > 0 ? (
        <ul class="citation-list">
          {related.map((item) => (
            <li>
              <Citation item={item} showType />
            </li>
          ))}
        </ul>
      ) : (
        <p data-no-related>No work in this area is listed yet.</p>
      )}
      <p class="more-link">
        <a href={gardenTagHref(area.id)}>
          See this area in the Garden <span aria-hidden="true">→</span>
        </a>
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .topic {
    padding-block: var(--space-7) var(--space-8);
  }

  .topic__thumb {
    max-width: 36rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-block: var(--space-5) var(--space-6);
  }

  .topic__section + .topic__section {
    margin-top: var(--space-6);
  }

  .topic__section h2 {
    font-size: var(--fs-h3);
  }

  .topic__facts {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
    margin: 0 0 var(--space-4);
  }

  .topic__facts div {
    display: grid;
    gap: 0 var(--space-3);
  }

  @media (min-width: 40.0625rem) {
    .topic__facts div {
      grid-template-columns: 6rem minmax(0, 1fr);
    }
  }

  .topic__facts dt {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .topic__facts dd {
    margin: 0;
  }
</style>
