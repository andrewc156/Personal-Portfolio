---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerrainArt from '../components/site/TerrainArt.astro';
---

<BaseLayout title="Page not found" description="This page could not be found.">
  <section class="not-found container" aria-labelledby="nf-title">
    <p class="eyebrow">Error 404</p>
    <h1 id="nf-title">This page has gone under water.</h1>
    <p>The address may be mistyped, or the page may have moved.</p>
    <p>
      <a href="/">Go to the home page</a>
    </p>
    <figure class="not-found__art">
      <TerrainArt label="Illustration: ridges of a landscape with water filling the low ground." />
    </figure>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-8);
  }

  .not-found__art {
    margin: var(--space-6) 0 0;
    max-width: 36rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
</style>
